# MS Fila (Azure SQL) — copie para .env e ajuste. NUNCA versione o .env.
PORT=8081

# Local (SQL Server em Docker). Azure SQL:
# DB_URL=jdbc:sqlserver://<servidor>.database.windows.net:1433;databaseName=openprontuario;encrypt=true;trustServerCertificate=false;loginTimeout=30
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=openprontuario;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=<senha-forte>

# Vazio = mensageria desabilitada (eventos só no log, com WARN na inicialização).
# Emulador do compose: Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_TOPIC=eventos-atendimento

# Segredo compartilhado com BFF, Function e MS Prontuário (obrigatório; sem default)
INTERNAL_API_KEY=dev-internal-key
